# Copie para .env (nunca commite o .env). Tudo é opcional no PoC local.

# --- API ---
API_PORT=3001
DB_PATH=./data/edumind.db
APP_NAME=EduMind
COOKIE_SECURE=false
# Cria/promove um administrador ao iniciar a API (opcional)
ADMIN_EMAIL=admin@edumind.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Administrador

# --- Professor Tutor (sem chave = modo demonstração) ---
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-haiku-4.5

# --- Scraper de aulas ---
# mock = portal de demonstração local (npm run dev:portal); portal = faculdade real (adaptador a criar)
SCRAPER_SOURCE=mock
PORTAL_URL=http://localhost:4010
PORTAL_USER=aluno@portal.local
PORTAL_PASSWORD=aluno123
PORTAL_PORT=4010
# Caminho do Chromium, se não usar o do Playwright (ex.: /opt/pw-browsers/chromium)
CHROMIUM_PATH=
